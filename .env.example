# Copy this file to .env and change the values:   cp .env.example .env
# .env is in .gitignore, so real passwords are never committed.

POSTGRES_USER=mobility
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mobility

# Web interfaces (user name: admin)
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_SECRET_KEY=change-me-to-a-long-random-string
GRAFANA_ADMIN_PASSWORD=change-me

# Producer: hours of history simulated on the very first start (0 = none)
BACKFILL_HOURS=24

# Spark streaming settings
WATERMARK=10 minutes
TRIGGER_INTERVAL=5 seconds
MAX_OFFSETS_PER_TRIGGER=20000
SPARK_MASTER=local[4]
