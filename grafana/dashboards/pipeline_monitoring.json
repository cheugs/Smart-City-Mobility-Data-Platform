    {
      "id": 9,
      "type": "timeseries",
      "title": "End-to-end latency (Kafka -> PostGIS)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
