            "uid": "postgis"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_bin('1 minute', batch_timestamp, timestamptz '2000-01-01') AS time, query_name AS metric,\n  max(kafka_lag) AS value FROM monitoring.stream_progress WHERE $__timeFilter(batch_timestamp) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
