          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, sum(reading_count) AS received, 360 AS expected\nFROM stream.traffic_per_minute WHERE $__timeFilter(window_start) GROUP BY 1 ORDER BY 1"
