    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput per streaming query (events/s)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_bin('1 minute', batch_timestamp, timestamptz '2000-01-01') AS time, query_name AS metric,\n  sum(num_input_rows)/60.0 AS value FROM monitoring.stream_progress WHERE $__timeFilter(batch_timestamp) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Kafka consumer lag per query",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
