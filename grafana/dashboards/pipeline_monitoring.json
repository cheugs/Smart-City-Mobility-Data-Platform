            "uid": "postgis"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_bin('1 minute', processed_at, timestamptz '2000-01-01') AS time,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM processed_at - kafka_time)) AS p50,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM processed_at - kafka_time)) AS p95\nFROM raw.traffic_readings WHERE $__timeFilter(processed_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
